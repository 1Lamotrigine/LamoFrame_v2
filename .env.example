# Скопируйте файл в .env и заполните значения.
# .env в репозиторий не попадает (см. .gitignore).

# --- Django ---
# Секретный ключ. В проде обязателен: без него сессии сбрасываются при рестарте.
DJANGO_SECRET_KEY=
# Хосты, с которых можно обращаться к сайту (через запятую).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# 0 — прод-режим (по умолчанию), 1 — режим отладки.
DJANGO_DEBUG=0
# Включайте на реальном HTTPS-деплое.
DJANGO_SECURE_COOKIES=0
DJANGO_HTTPS=0

# --- Демо-данные (создаются только при SEED_DEMO=1) ---
SEED_DEMO=0
DEMO_PASSWORD=
ADMIN_PASSWORD=

# --- Вход через Google (django-allauth) ---
# Возьмите ключи в Google Cloud Console:
#   APIs & Services → Credentials → OAuth client ID → Web application.
# Authorized redirect URI:
#   http://localhost:8000/accounts/google/login/callback/
# Пока поля пусты, кнопка «Войти через Google» не показывается.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
